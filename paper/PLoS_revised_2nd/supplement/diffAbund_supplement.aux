\@writefile{lof}{\contentsline {figure}{\numberline {\textbf  {S8}}{\ignorespaces \textbf  {Significant differences in \textit  {PTEN} expression are driven by a few outlier samples:} Expression of the tumour suppressor gene, \textit  {PTEN}, in the Cancer Genome Atlas BRCA dataset is shown in histograms of read counts (\textbf  {left}) and centred log-ratio (CLR) abundance values (\textbf  {right}) calculated by ALDEx2. Bars are coloured by sample group. Bin width is 1,000 (reads) or 0.2 (CLR). The limited number of outlier samples in each group can clearly be seen at either end of the histograms, with most samples overlapping in the centre.\relax }}{11}{figure.caption.22}\protected@file@percent }
\newlabel{fig:supFigPTEN}{{\textbf  {S8}}{11}{\textbf {Significant differences in \textit {PTEN} expression are driven by a few outlier samples:} Expression of the tumour suppressor gene, \textit {PTEN}, in the Cancer Genome Atlas BRCA dataset is shown in histograms of read counts (\textbf {left}) and centred log-ratio (CLR) abundance values (\textbf {right}) calculated by ALDEx2. Bars are coloured by sample group. Bin width is 1,000 (reads) or 0.2 (CLR). The limited number of outlier samples in each group can clearly be seen at either end of the histograms, with most samples overlapping in the centre.\relax }{figure.caption.22}{}}
