\citation{gloor:effect}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Sensitivity is reduced when adding increasing amounts of scale uncertainty.} True positive rates (TPR; i.e. sensitivity) for the indicated tool and dataset combinations were calculated separately for each 0.1 increment in the model difference between groups threshold (i.e. the simulated or `true' log\textsubscript  {2} fold-change between groups, as determined by binomial thinning). Each data point represents the TPR when considering dataset features with a simulated log-difference at or above the given x-axis threshold. \DIFaddbeginFL  {\color {blue}\uwave {Features were considered differentially abundant at a BH-adjusted }}\textit  {{\color {blue}\uwave {P}}}{\color {blue}\uwave {-value of $<$0.05.}}\DIFaddendFL  \relax }}{9}{figure.caption.15}\protected@file@percent }
\newlabel{fig:TPR}{{2}{9}{\textbf {Sensitivity is reduced when adding increasing amounts of scale uncertainty.} True positive rates (TPR; i.e. sensitivity) for the indicated tool and dataset combinations were calculated separately for each 0.1 increment in the model difference between groups threshold (i.e. the simulated or `true' log\textsubscript {2} fold-change between groups, as determined by binomial thinning). Each data point represents the TPR when considering dataset features with a simulated log-difference at or above the given x-axis threshold. \DIFaddbeginFL \DIFaddFL {Features were considered differentially abundant at a BH-adjusted }\textit {\DIFaddFL {P}}\DIFaddFL {-value of $<$0.05.}\DIFaddendFL \relax }{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Number of differentially expressed genes reported by ALDEx2 and ALDEx3 for the immunotherapy dataset.} Data expressed as the mean of all 100 iterations rounded to the nearest integer, with standard deviations given in parentheses. \DIFaddbeginFL  {\color {blue}\uwave {Features were considered differentially abundant at a BH-adjusted }}\textit  {{\color {blue}\uwave {P}}}{\color {blue}\uwave {-value of $<$0.05.}}\DIFaddendFL  \relax }}{9}{table.caption.17}\protected@file@percent }
\newlabel{tab:sigGenes}{{1}{9}{\textbf {Number of differentially expressed genes reported by ALDEx2 and ALDEx3 for the immunotherapy dataset.} Data expressed as the mean of all 100 iterations rounded to the nearest integer, with standard deviations given in parentheses. \DIFaddbeginFL \DIFaddFL {Features were considered differentially abundant at a BH-adjusted }\textit {\DIFaddFL {P}}\DIFaddFL {-value of $<$0.05.}\DIFaddendFL \relax }{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Accounting for scale uncertainty reduces the total number of features identified as differentially expressed.} A randomly selected iteration from the \DIFdelbeginFL  {\color {red}\sout {ALDEx2 and ALDEx3 }}\DIFdelendFL  PD1 immunotherapy dataset \DIFdelbeginFL  {\color {red}\sout {analyses }}\DIFdelendFL  was used to create volcano plots (\textbf  {A, B}) and effect plots (\textbf  {C, D}) \DIFaddbeginFL  {\color {blue}\uwave {for the corresponding ALDEx2 and ALDEx3 analyses}}\DIFaddendFL  . Each data point represents a feature from the scale-na\"ive analysis (\textgamma \nobreakspace  {}= 0.001). Grey points indicate non-significant features; coloured points indicate features which are significantly different between groups after a given amount of scale uncertainty has been added to the model. Grey dashed lines indicate either: BH-adjusted \textit  {P}-value $<$0.05 (\textbf  {A, B}) or equivalent difference between and within groups (\textbf  {C, D}).\relax }}{10}{figure.caption.18}\protected@file@percent }
\newlabel{fig:volcano}{{3}{10}{\textbf {Accounting for scale uncertainty reduces the total number of features identified as differentially expressed.} A randomly selected iteration from the \DIFdelbeginFL \DIFdelFL {ALDEx2 and ALDEx3 }\DIFdelendFL PD1 immunotherapy dataset \DIFdelbeginFL \DIFdelFL {analyses }\DIFdelendFL was used to create volcano plots (\textbf {A, B}) and effect plots (\textbf {C, D}) \DIFaddbeginFL \DIFaddFL {for the corresponding ALDEx2 and ALDEx3 analyses}\DIFaddendFL . Each data point represents a feature from the scale-na\"ive analysis (\textgamma ~= 0.001). Grey points indicate non-significant features; coloured points indicate features which are significantly different between groups after a given amount of scale uncertainty has been added to the model. Grey dashed lines indicate either: BH-adjusted \textit {P}-value $<$0.05 (\textbf {A, B}) or equivalent difference between and within groups (\textbf {C, D}).\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {ALDEx3 requires a lower difference between groups to identify differentially expressed genes compared to ALDEx2.} (\textbf  {Left}) For each of the 100 iterations of the PD1 immunotherapy transcriptome dataset, the minimum absolute difference between groups needed for a gene to be reported as differentially expressed by ALDEx2 and ALDEx3 was recorded, based on a BH-adjusted \textit  {P}-value of $<$0.05, for \textgamma \nobreakspace  {}values ranging from 0 to 0.5. The distributions of these values are coloured by tool and \textgamma \nobreakspace  {}value, with dashed lines indicating the mean. (\textbf  {Right}) Minimum absolute differences required for a significant result \DIFaddbeginFL  {\color {blue}\uwave {(BH-adjusted }}\textit  {{\color {blue}\uwave {P}}}{\color {blue}\uwave {-value $<$0.05) }}\DIFaddendFL  were calculated across all 100 iterations for all \DIFaddbeginFL  {\color {blue}\uwave {10 RNA-seq }}\DIFaddendFL  datasets\DIFaddbeginFL  {\color {blue}\uwave {, plus all 21 pairwise comparisons of groups from the non-permuted 16S rRNA amplicon sequencing dataset}}\DIFaddendFL  . Mean values per dataset are plotted ($\pm $ SEM) for ALDEx2 and ALDEx3. Cancer Genome Atlas datasets are aggregated and plotted data represent a mean of means at each \textgamma \nobreakspace  {}value.\relax }}{11}{figure.caption.19}\protected@file@percent }
\newlabel{fig:density}{{4}{11}{\textbf {ALDEx3 requires a lower difference between groups to identify differentially expressed genes compared to ALDEx2.} (\textbf {Left}) For each of the 100 iterations of the PD1 immunotherapy transcriptome dataset, the minimum absolute difference between groups needed for a gene to be reported as differentially expressed by ALDEx2 and ALDEx3 was recorded, based on a BH-adjusted \textit {P}-value of $<$0.05, for \textgamma ~values ranging from 0 to 0.5. The distributions of these values are coloured by tool and \textgamma ~value, with dashed lines indicating the mean. (\textbf {Right}) Minimum absolute differences required for a significant result \DIFaddbeginFL \DIFaddFL {(BH-adjusted }\textit {\DIFaddFL {P}}\DIFaddFL {-value $<$0.05) }\DIFaddendFL were calculated across all 100 iterations for all \DIFaddbeginFL \DIFaddFL {10 RNA-seq }\DIFaddendFL datasets\DIFaddbeginFL \DIFaddFL {, plus all 21 pairwise comparisons of groups from the non-permuted 16S rRNA amplicon sequencing dataset}\DIFaddendFL . Mean values per dataset are plotted ($\pm $ SEM) for ALDEx2 and ALDEx3. Cancer Genome Atlas datasets are aggregated and plotted data represent a mean of means at each \textgamma ~value.\relax }{figure.caption.19}{}}
\citation{repana_network_2019}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \DIFdelbeginFL  \textbf  {{\color {red}\sout {Linear models of gamma values vs. minimum log differences required for significance over 100 iterations of ALDEx2 and ALDEx3:}}} \DIFdelendFL  \DIFaddbeginFL  \textbf  {{\color {blue}\uwave {Linear models of gamma values vs. minimum log differences required for significance when using ALDEx2 and ALDEx3:}}} \DIFaddendFL  The minimum log difference required for a statistically significant result (\DIFaddbeginFL  {\color {blue}\uwave {BH-adjusted }}\DIFaddendFL  \textit  {P}\DIFaddbeginFL  {\color {blue}\uwave {-value }}\DIFaddendFL  $<$0.05) was calculated for each iteration of the ALDEx2 and ALDEx3 analyses for all \DIFaddbeginFL  {\color {blue}\uwave {RNA-seq }}\DIFaddendFL  datasets\DIFaddbeginFL  {\color {blue}\uwave {, as well as for all pairwise age group comparisons of the lone 16S rRNA amplicon sequencing dataset}}\DIFaddendFL  . Linear regression was performed on these minimum differences vs. the corresponding gamma values and the mean coefficients and intercepts of the models are reported. Values in parentheses represent standard deviations.\relax }}{12}{table.caption.20}\protected@file@percent }
\newlabel{tab:regression}{{2}{12}{\DIFdelbeginFL \textbf {\DIFdelFL {Linear models of gamma values vs. minimum log differences required for significance over 100 iterations of ALDEx2 and ALDEx3:}} \DIFdelendFL \DIFaddbeginFL \textbf {\DIFaddFL {Linear models of gamma values vs. minimum log differences required for significance when using ALDEx2 and ALDEx3:}} \DIFaddendFL The minimum log difference required for a statistically significant result (\DIFaddbeginFL \DIFaddFL {BH-adjusted }\DIFaddendFL \textit {P}\DIFaddbeginFL \DIFaddFL {-value }\DIFaddendFL $<$0.05) was calculated for each iteration of the ALDEx2 and ALDEx3 analyses for all \DIFaddbeginFL \DIFaddFL {RNA-seq }\DIFaddendFL datasets\DIFaddbeginFL \DIFaddFL {, as well as for all pairwise age group comparisons of the lone 16S rRNA amplicon sequencing dataset}\DIFaddendFL . Linear regression was performed on these minimum differences vs. the corresponding gamma values and the mean coefficients and intercepts of the models are reported. Values in parentheses represent standard deviations.\relax }{table.caption.20}{}}
