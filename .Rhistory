immuno.data.out.aldex.u <- list(xup.aldex)
return(list(conditions=conditions_p, thin.data=thin.data.out.aldex, u.data=data.out.aldex.u, r.data=data.out.aldex.r, p.data=data.out.aldex.p))
}
