plot(rownames(des.imm$TPFPR), jnk.des$TPFPR[,1], ylim=c(0,1), type='b', xlab="minimum coefficient", ylab="TPR FDR")
plot(rownames(des.imm$TPFPR), des.imm$TPFPR[,1], ylim=c(0,1), type='b', xlab="minimum coefficient", ylab="TPR FDR")
