gp1 <- which(conds_th == levels(factor(conds_th))[1])
gp2 <- which(conds_th == levels(factor(conds_th))[2])
gp1 <- which(conds_th == levels(factor(conds_th))[1])
gp2 <- which(conds_th == levels(factor(conds_th))[2])
conditions_t <- conds_th
conditions_t[gp1] <- 0
conditions_t[gp2] <- 1
conditions_t <- as.numeric(conditions_t)
Xt <- formula(~conditions_t)
datat <- data.frame(conditions_t=conditions_t)
nsample <- 1000
# randomized conditions only (.r)
aldex3.r <- aldex(immuno.data, Xt, data=datat, nsample=nsample, scale=clr.sm, gamma=1e-3, nloop = 1)
# LFC column is estimate colu
aldex3.t <- aldex(data_th, Xt, data=datat, nsample=nsample, scale=clr.sm, gamma=1e-3, nloop = 1)
# you will need to change the path to ALDEx3 repository
devtools::load_all('~/Documents/github/ALDEx3')
library(seqgendiff, warn.conflicts=F)
library(edgeR, warn.conflicts=F)
#immuno/PD1 dataset loading
raw_counts_immuno <- 'https://raw.githubusercontent.com/amurariu/usri/main/data/imm-GSE91061_raw_counts_GRCh38.p13_NCBI.tsv'
meta_immuno <- 'https://raw.githubusercontent.com/amurariu/usri/main/data/imm_metadata.txt'
immuno<-read.table(file=raw_counts_immuno, header = T, skip=35, sep='\t', row.names = 1)
m <- read.table(file=meta_immuno, header=F, row.names=1, sep='\t')
#establishing conditions for PD1
conditions_p <- rep("Pre", 109)
conditions_p[grep("_On",m)] <- "On"
immuno.conds <- data.frame(conditions_p) #changed conditions to conditions_p to be consistent across datasets
#edgeR conditions for initial filtering
#PD1
y_pd1 <- DGEList(counts=immuno, group=factor(conditions_p))
keep_pd1 <- filterByExpr(y_pd1)
y_pd1 <- y_pd1[keep_pd1,keep.lib.sizes=FALSE]
immuno.data <- y_pd1$counts #filtered base dataset
immuno.data_0.aldex3 <- ald3.fun(data=immuno.data, conditions=immuno.conds$conditions_p, nloop=1, gamma=1e-3)
source('code/ald3.fun.R')
immuno.data_0.aldex3 <- ald3.fun(data=immuno.data, conds=immuno.conds$conditions_p, nloop=1, gamma=1e-3)
immuno.data_0.aldex3
immuno.data_0.aldex3$u.data
immuno.data_0.aldex3$t.data
summary(immuno.data_0.aldex3)
head(immuno.data_0.aldex3)
str(immuno.data_0.aldex3)
