library(gapminder)
library(dplyr)
# pull economic development data
gap <- gapminder
gap
# A tibble: 1,704 × 6
#  country       continent year    lifeExp pop       gdpPercap
#  <fct>        <fct>      <int>   <dbl>   <int>     <dbl>
#1  Afghanistan Asia       1952    28.8    8425333   779.
#2  Afghanistan Asia       1957    30.3    9240934   821.
#3  Afghanistan Asia       1962    32.0    10267083  853.
#4  Afghanistan Asia       1967    34.0    11537966  836.
#5  Afghanistan Asia       1972    36.1    13079460  740.
#6  Afghanistan Asia       1977    38.4    14880372  786.
#7  Afghanistan Asia       1982    39.9    12881816  978.
#8  Afghanistan Asia       1987    40.8    13867957  852.
#9  Afghanistan Asia       1992    41.7    16317921  649.
#10 Afghanistan Asia       1997    41.8    22227415  635.
# … with 1,694 more rows
# ℹ Use `print(n = ...)` to see more rows
# Data wrangling using dplyr----------------------------------------------------
# Use pipes in r (%>%) to pass objects onto other functions
# In 'dplyr', functions are called 'verbs', like 'filter' and 'arrange'
# Filter gapminder dataset by year, country or both
yr.2007<-gap %>%
filter(year == 2007)
afghan<- gap %>%
filter(country=="Afghanistan")
china.1957 <- gap %>%
filter(country==1957, country=="China")
# Use 'arrange' to sort gapminder via pipes (defaults to ascending order)
gdp.low.high<- gap %>%
arrange(gdpPercap)
gdp.low.high
# Can sort by descending order by specifying desc() after arrange()
gdp.high.low<-gap%>%
arrange(desc(gdpPercap))
gdp.high.low
# Can chain commands together using multiple pipes, e.g. filter then arrange
lifeExp.2007.descend<-gap%>%
filter(year==2007)%>%
arrange(desc(lifeExp))
lifeExp.2007.descend
# The select() verb is similar to filter(), but will subset your data by column
# instead of by row (column order in the tibble respects the code order):
gap%>%
select(country,continent,lifeExp, year)
# mutate() verb is used to change or add variables
# For example, divide population variable by 1000000
gap.popDivided <- gap%>%
mutate(pop=pop/1000000)
gap.popDivided
# Add new variable to calculate total GDP (not GDP per capita)
# New variable is GDP x population, stored in new column
gap.with.totalGDP<-gap%>%
mutate(totalGDP=gdpPercap*pop)
gap.with.totalGDP
# To check if two values are identical across columns and store this data in
# a new column, then summarise the percentage of how many rows have a TRUE value
# , the syntax would be (never gave me any example data for this one, so just
# trust me, I guess?):
mydata%>%
mutate(new_col=var_1==var_2)%>%
summarise(percent_new_col=mean(new_col))
ggplot(yr.2007,aes(x=gdpPercap, y = lifeExp))+
geom_point()
