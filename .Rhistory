plot(coef, diff.tpr.ald23[1,], ylim = c(0,0.04), col=rgb(0,0,0,0.2), type='l', main = 'difference between')
plot(coef, diff.tpr.ald23[1,], ylim = c(0,0.0.4), col=rgb(0,0,0,0.2), type='l', main = 'difference between')
