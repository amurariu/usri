source('code/get_confusion.R')
graph.fun <- function(aldex_0_var, aldex_1_var, aldex_2_var, aldex_5_var, aldex3_0_var, aldex3_1_var, aldex3_2_var, aldex3_5_var){
#perform get_confusion function first
ald0.conf <- get_confusion(aldex_0_var, "ALDEx2", FDR=0.1)
ald1.conf <- get_confusion(aldex_1_var, "ALDEx2", FDR=0.1)
ald2.conf <- get_confusion(aldex_2_var, "ALDEx2", FDR=0.1)
ald5.conf <- get_confusion(aldex_5_var, "ALDEx2", FDR=0.1)
ald3_0.conf <- get_confusion(aldex3_0_var, "ALDEx3", FDR=0.1)
ald3_1.conf <- get_confusion(aldex3_1_var, "ALDEx3", FDR=0.1)
ald3_2.conf <- get_confusion(aldex3_2_var, "ALDEx3", FDR=0.1)
ald3_5.conf <- get_confusion(aldex3_5_var, "ALDEx3", FDR=0.1)
coeff <- as.numeric(rownames(ald0.conf$TPFPR))
par(mfrow=c(1,2))
plot(coeff, ald0.conf$TPFPR[1,1], col="black", type='b', lty=1,
xlab="modeled LFC", ylab="TPR/FDR", xlim=c(0,1), ylim=c(0,1),
main="FP = min LFC")
for (i in 1:nloop){
points(coeff,ald1.conf$TPFPR[i,1], col="black", type='b', pch='1', lty=1, cex=0.6)
points(coeff,ald2.conf$TPFPR[i,1], col="black", type='b', pch='2', lty=1, cex=0.6)
points(coeff,ald5.conf$TPFPR[i,1], col="black", type='b', pch='5', lty=1, cex=0.6)
points(coeff,ald0.conf$TPFPR[i,2], col="black", type='b', lty=2)
points(coeff,ald1.conf$TPFPR[i,2], col="black", type='b', lty=2, pch='1', cex=0.6)
points(coeff,ald2.conf$TPFPR[i,2], col="black", type='b', lty=2, pch='2', cex=0.6)
points(coeff,ald5.conf$TPFPR[i,2], col="black", type='b', lty=2, pch='5', cex=0.6)
points(coeff, ald3_0.conf$TPFPR[i,1], col="blue", type='b', lty=1)
points(coeff,ald3_1.conf$TPFPR[i,1], col="blue", type='b', pch='1', lty=1, cex=0.6)
points(coeff,ald3_2.conf$TPFPR[i,1], col="blue", type='b', pch='2', lty=1, cex=0.6)
points(coeff,ald3_5.conf$TPFPR[i,1], col="blue", type='b', pch='5', lty=1, cex=0.6)
points(coeff,ald3_0.conf$TPFPR[i,2], col="blue", type='b', lty=2)
points(coeff,ald3_1.conf$TPFPR[i,2], col="blue", type='b', lty=2, pch='1', cex=0.6)
points(coeff,ald3_2.conf$TPFPR[i,2], col="blue", type='b', lty=2, pch='2', cex=0.6)
points(coeff,ald3_5.conf$TPFPR[i,2], col="blue", type='b', lty=2, pch='5', cex=0.6)
abline(h=0.05, lty=3, lwd=2, col="grey") }
plot(coeff, ald0.conf$TPFPR[1,5], col="black", type='b', lty=1,
xlab="modeled LFC", ylab="TPR/FDR", xlim=c(0,1), ylim=c(0,1),
main="FP = min LFC")
for (i in 1:nloop){
points(coeff,ald1.conf$TPFPR[i,5], col="black", type='b', pch='1', lty=1, cex=0.6)
points(coeff,ald2.conf$TPFPR[i,5], col="black", type='b', pch='2', lty=1, cex=0.6)
points(coeff,ald5.conf$TPFPR[i,5], col="black", type='b', pch='5', lty=1, cex=0.6)
points(coeff,ald0.conf$TPFPR[i,6], col="black", type='b', lty=2)
points(coeff,ald1.conf$TPFPR[i,6], col="black", type='b', lty=2, pch='1', cex=0.6)
points(coeff,ald2.conf$TPFPR[i,6], col="black", type='b', lty=2, pch='2', cex=0.6)
points(coeff,ald5.conf$TPFPR[i,6], col="black", type='b', lty=2, pch='5', cex=0.6)
points(coeff, ald3_0.conf$TPFPR[i,5], col="blue", type='b', lty=2)
points(coeff,ald3_1.conf$TPFPR[i,5], col="blue", type='b', pch='1', lty=1, cex=0.6)
points(coeff,ald3_2.conf$TPFPR[i,5], col="blue", type='b', pch='2', lty=1, cex=0.6)
points(coeff,ald3_5.conf$TPFPR[i,5], col="blue", type='b', pch='5', lty=1, cex=0.6)
points(coeff,ald3_0.conf$TPFPR[i,6], col="blue", type='b', lty=2)
points(coeff,ald3_1.conf$TPFPR[i,6], col="blue", type='b', lty=2, pch='1', cex=0.6)
points(coeff,ald3_2.conf$TPFPR[i,6], col="blue", type='b', lty=2, pch='2', cex=0.6)
points(coeff,ald3_5.conf$TPFPR[i,6], col="blue", type='b', lty=2, pch='5', cex=0.6)
abline(h=0.05, lty=3, lwd=2, col="grey")
}
}
graph.fun(aldex_0_var = immuno.data_0.aldex2, aldex_1_var = immuno.data_1.aldex2, aldex_2_var = immuno.data_2.aldex2, aldex_5_var = immuno.data_5.aldex2, aldex3_0_var = immuno.data_0.aldex3, aldex3_1_var = immuno.data_1.aldex3, aldex3_2_var = immuno.data_1.aldex3, aldex3_5_var = immuno.data_5.aldex3)
rm(thca.data_0.aldex2)
rm(thca.data_0.aldex3)
rm(thca.data_2.aldex2)
rm(thca.data_1.aldex2)
rm(thca.data_1.aldex3)
rm(thca.data_2.aldex3)
rm(thca.data_5.aldex2)
rm(thca.data_5.aldex3)
rm(thca.data.limma)
